<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="glorified notepad">
      {assigns[:page_title]}
    </.live_title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="glorified notepad"
      href={~p"/feed.rss"}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <details id="rootring-widget" class="rootring-widget rr-v1">
      <summary aria-label="rootring webring">
        <div class="rr-pixels">
          <span style="background:#FF0000;width:7px;height:7px"></span><span style="background:#00FF00;width:7px;height:7px"></span><span style="background:#0000FF;width:7px;height:7px"></span><span style="background:#FFFF00;width:7px;height:7px"></span><span style="background:#FF00FF;width:7px;height:7px"></span><span style="background:#00FFFF;width:7px;height:7px"></span><span style="background:#FFA500;width:7px;height:7px"></span><span style="background:#800080;width:7px;height:7px"></span><span style="background:#A52A2A;width:7px;height:7px"></span><span style="background:#df9390;width:7px;height:7px"></span><span style="background:#444c72;width:7px;height:7px"></span><span style="background:#6c868f;width:7px;height:7px"></span>
        </div>
        <div class="rr-pill-label"><a href="https://rootr.ing/">rootring</a></div>
      </summary>
      <nav class="rr-nav-links" aria-label="Webring navigation">
        <div class="rr-label-bar">rootring</div>
        <a class="rr-link" href="https://rootr.ing/prev?site=https://glorifiednotepad.net">
          <span class="sym">&lt;</span> prev
        </a>
        <a class="rr-link" href="https://rootr.ing/random"><span class="sym">~</span> rand</a>
        <a class="rr-link" href="https://rootr.ing/next?site=https://glorifiednotepad.net">
          <span class="sym">&gt;</span> next
        </a>
      </nav>
    </details>
    <script>
      (function() {
        var w = document.getElementById('rootring-widget');
        if (!sessionStorage.getItem('rootring-closed')) {
          w.setAttribute('open', '');
        }
        w.addEventListener('toggle', function() {
          if (w.open) {
            sessionStorage.removeItem('rootring-closed');
          } else {
            sessionStorage.setItem('rootring-closed', '1');
          }
        });
      })();
    </script>
  </body>
</html>
