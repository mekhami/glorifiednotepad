<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="glorified notepad">
      {assigns[:page_title]}
    </.live_title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="glorified notepad"
      href={~p"/feed.rss"}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <details id="rootring-widget" class="rootring-widget">
      <summary>
        <span class="summary-title">
          <a href="https://rootr.ing/" style="color: inherit; text-decoration: none;">rootring</a>
        </span>
        <span class="summary-hint">webring</span>
      </summary>
      <nav aria-label="Webring">
        <a href="https://rootr.ing/prev?site=https://glorifiednotepad.net">← Prev</a>
        <a href="https://rootr.ing/random">Random</a>
        <a href="https://rootr.ing/directory">Directory</a>
        <a href="https://rootr.ing/next?site=https://glorifiednotepad.net">Next →</a>
      </nav>
    </details>
    <script>
      (function() {
        var w = document.getElementById('rootring-widget');
        if (!sessionStorage.getItem('rootring-closed')) {
          w.setAttribute('open', '');
        }
        w.addEventListener('toggle', function() {
          if (w.open) {
            sessionStorage.removeItem('rootring-closed');
          } else {
            sessionStorage.setItem('rootring-closed', '1');
          }
        });
      })();
    </script>
  </body>
</html>
