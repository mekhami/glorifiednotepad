<.live_component module={IndieWeb.DoodleCanvasComponent} id="doodle-canvas" />

<%!-- SVG filter for hand-drawn highlight effect --%>
<svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true">
  <defs>
    <filter id="hl-handdrawn" x="-2%" y="-15%" width="110%" height="140%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.018"
        numOctaves="3"
        result="noise"
        seed="5"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="noise"
        scale="4"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </defs>
</svg>

<%!-- Canvas interaction zones for left/right margins --%>
<div id="canvas-zone-left" class="canvas-margin-zone"></div>
<div id="canvas-zone-right" class="canvas-margin-zone"></div>

<div class="gradient-overlay-top"></div>
<div class="gradient-overlay-bottom"></div>

<%= if @post_not_found do %>
  <div class="post-header" style="width: 40%;">
    <h2>404: Post Not Found</h2>
  </div>

  <div class="post-content" style="width: 40%;">
    <p>The post you're looking for doesn't exist.</p>
    <p><.link navigate="/">[home]</.link></p>
  </div>
<% else %>
  <%= if @post.sidenotes != [] do %>
    <%!-- Two-column layout: post card + sidenotes panel --%>
    <div class="post-sidenotes-wrapper" style={"--post-col-width: #{@post.width};"}>
      <div class="post-column">
        <div class="post-header" id={@post.id}>
          <div class="post-header-top">
            <h2>{@post.title}</h2>
            <.link navigate={"/p/#{@post.id}"} class="post-header-link">[link]</.link>
          </div>
          <%= if @post.pixel_colors && @post.pixel_colors != [] do %>
            <div class="post-header-pixels" role="presentation" aria-hidden="true">
              <span
                :for={color <- @post.pixel_colors}
                class="pixel"
                style={"background: #{color};"}
              >
              </span>
            </div>
          <% end %>
        </div>

        <div
          id="post-content"
          class="post-content post-page"
          phx-hook="ImageMagnifier"
        >
          <div style="text-align: right; margin-bottom: 1rem; opacity: 0.7;">
            {Calendar.strftime(@post.date, "%B %-d, %Y")}
          </div>
          {Phoenix.HTML.raw(@post.html)}

          <%= if @comments != [] do %>
            <div class="comments-section">
              <p>comments:</p>
              <div :for={comment <- @comments} class="comment">
                <span class="comment-author">{comment.author_name}:</span>
                <span class="comment-body">
                  {Phoenix.HTML.raw(render_comment_markdown(comment.body))}
                </span>
              </div>
            </div>
          <% end %>

          <div class="comment-button-container">
            <button class="leave-comment-btn" phx-click="open_comment_modal">
              leave a comment
            </button>
          </div>

          <div style="margin-top: 1rem;">
            <.link navigate="/">[home]</.link>
          </div>
        </div>
      </div>

      <%!-- Sidenotes panel --%>
      <div
        class="sidenotes-panel"
        id={"sidenotes-panel-#{@post.id}"}
        phx-hook="SidenotesAlign"
      >
        <div class="sidenotes-panel-header">notes</div>
        <div class="sidenotes-body">
          <%= for sn <- @post.sidenotes do %>
            <div class="sidenote-entry" data-sn={"#{@post.id}-#{sn.number}"}>
              <sup class="sn-label">{sn.number}</sup>
              {Phoenix.HTML.raw(sn.html)}
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <%!-- Standard layout (no sidenotes) — unchanged from before --%>
    <div class="post-header" id={@post.id} style={"width: #{@post.width};"}>
      <div class="post-header-top">
        <h2>{@post.title}</h2>
        <.link navigate={"/p/#{@post.id}"} class="post-header-link">[link]</.link>
      </div>
      <%= if @post.pixel_colors && @post.pixel_colors != [] do %>
        <div class="post-header-pixels" role="presentation" aria-hidden="true">
          <span :for={color <- @post.pixel_colors} class="pixel" style={"background: #{color};"}>
          </span>
        </div>
      <% end %>
    </div>

    <div
      id="post-content"
      class="post-content post-page"
      style={"width: #{@post.width};"}
      phx-hook="ImageMagnifier"
    >
      <div style="text-align: right; margin-bottom: 1rem; opacity: 0.7;">
        {Calendar.strftime(@post.date, "%B %-d, %Y")}
      </div>
      {Phoenix.HTML.raw(@post.html)}

      <%= if @comments != [] do %>
        <div class="comments-section">
          <p>comments:</p>
          <div :for={comment <- @comments} class="comment">
            <span class="comment-author">{comment.author_name}:</span>
            <span class="comment-body">
              {Phoenix.HTML.raw(render_comment_markdown(comment.body))}
            </span>
          </div>
        </div>
      <% end %>

      <div class="comment-button-container">
        <button class="leave-comment-btn" phx-click="open_comment_modal">
          leave a comment
        </button>
      </div>

      <div style="margin-top: 1rem;">
        <.link navigate="/">[home]</.link>
      </div>
    </div>
  <% end %>
<% end %>

<%!-- Image magnify modal --%>
<%= if @image_modal_src do %>
  <div
    class="image-modal-overlay"
    phx-click="close_image_modal"
    phx-window-keydown="close_image_modal"
    phx-key="Escape"
  >
    <div class="image-modal-container" phx-click={JS.exec("stop")}>
      <img src={@image_modal_src} alt="" class="image-modal-img" />
      <button phx-click="close_image_modal" class="image-modal-close">✕</button>
    </div>
  </div>
<% end %>

<%!-- AIM-style comment modal --%>
<%= if @modal_open do %>
  <div class="aim-modal-overlay" phx-click="close_comment_modal">
    <div class="aim-window" phx-click={JS.exec("stop")}>
      <div class="aim-titlebar">
        <span class="aim-title">Leave a Comment</span>
        <button phx-click="close_comment_modal" class="aim-close">✕</button>
      </div>
      <div class="aim-body">
        <.form
          for={@comment_form}
          id="comment-form"
          phx-submit="submit_comment"
          phx-change="validate_comment"
        >
          <input type="hidden" name="comment[post_id]" value={@post.id} />

          <div class="aim-field">
            <label>Screen Name:</label>
            <.input field={@comment_form[:author_name]} type="text" />
          </div>

          <div class="aim-field">
            <label>Message:</label>
            <.input field={@comment_form[:body]} type="textarea" rows="6" />
            <span class="char-count">
              {1000 - String.length(Phoenix.HTML.Form.input_value(@comment_form, :body) || "")} characters remaining
            </span>
          </div>

          <div class="aim-buttons">
            <button type="submit" class="aim-send-btn">Send</button>
            <button type="button" phx-click="close_comment_modal" class="aim-cancel-btn">
              Cancel
            </button>
          </div>
        </.form>
      </div>
    </div>
  </div>
<% end %>
