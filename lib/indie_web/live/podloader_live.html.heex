<%!-- Torn notebook page floating on the site's dusty rose background --%>
<div
  id="podloader-page"
  class="min-h-screen px-6 py-16 flex items-start justify-center font-mono"
  style="background-color: #df9390;"
>
  <%!-- The notebook page itself --%>
  <div
    class="relative w-full max-w-lg"
    style="
      background-color: #fdf8f0;
      background-image: repeating-linear-gradient(
        transparent, transparent 27px, #e2d9cc 27px, #e2d9cc 28px
      );
      background-position: 0 12px;
      border: 1px solid #ccc;
      box-shadow: 3px 3px 8px rgba(0,0,0,0.2), 1px 1px 0 #bbb;
      padding: 1.5rem 1.5rem 2rem 3.5rem;
    "
  >
    <%!-- Red margin line --%>
    <div
      class="absolute top-0 bottom-0 left-12"
      style="border-left: 2px solid #e8a0a0; pointer-events: none;"
    >
    </div>

    <%!-- Binder holes --%>
    <div
      class="absolute top-0 bottom-0 left-0 flex flex-col justify-around py-6"
      style="width: 3rem;"
    >
      <div
        class="mx-auto w-4 h-4 rounded-full"
        style="background: #df9390; border: 1px solid #bbb; box-shadow: inset 0 1px 2px rgba(0,0,0,0.15);"
      >
      </div>
      <div
        class="mx-auto w-4 h-4 rounded-full"
        style="background: #df9390; border: 1px solid #bbb; box-shadow: inset 0 1px 2px rgba(0,0,0,0.15);"
      >
      </div>
      <div
        class="mx-auto w-4 h-4 rounded-full"
        style="background: #df9390; border: 1px solid #bbb; box-shadow: inset 0 1px 2px rgba(0,0,0,0.15);"
      >
      </div>
    </div>

    <%!-- Page content --%>
    <div class="relative" style="z-index: 1;">
      <%!-- Title --%>
      <div class="mb-1">
        <h1
          class="font-bold leading-none uppercase"
          style="font-size: 2.6rem; color: #111; letter-spacing: -0.02em; line-height: 1.05;"
        >
          PODLOADER
        </h1>
        <span class="text-xs" style="color: #6c868f;">v0.1 &nbsp;·&nbsp; macOS</span>
      </div>

      <%!-- Rule --%>
      <div class="mb-5 mt-1" style="width: 55%; height: 3px; background: #111;"></div>

      <%!-- Body copy --%>
      <div class="text-sm mb-4 space-y-1" style="line-height: 2.15; color: #333;">
        <p>made this little app. it downloads podcasts.</p>
        <p><span style="color: #5a6285;">→</span> add your rss feed. download eps.</p>
        <p><span style="color: #5a6285;">→</span> cause you should have the stuff you pay for.</p>
        <p>
          <span style="color: #5a6285;">→</span> it adds idv3 metadata for you mp3 player nerds.
        </p>
      </div>

      <%!-- Dashed cut-line --%>
      <div
        class="my-5 text-center text-xs"
        style="border-top: 1px dashed #bbb; padding-top: 0.35rem; color: #bbb;"
      >
        ✂ &nbsp; cut here &nbsp; ✂
      </div>

      <%!-- Download button --%>
      <a
        id="download-btn"
        href="/downloads/podloader.dmg"
        download
        class="inline-block text-sm font-bold uppercase tracking-widest transition-colors duration-150"
        style="
          padding: 0.4rem 1.1rem;
          border: 2px solid #111;
          background: #111;
          color: #fdf8f0;
          box-shadow: 2px 2px 0 #555;
        "
        onmouseover="this.style.background='#444c72'; this.style.borderColor='#444c72';"
        onmouseout="this.style.background='#111'; this.style.borderColor='#111';"
      >
        ▼ download .dmg
      </a>

      <%!-- Requirements note --%>
      <p class="mt-3 text-xs" style="color: #ac9d9e;">requires macOS 13+</p>

      <%!-- Footer --%>
      <div class="mt-10 pt-3 text-xs" style="border-top: 1px dashed #ddd; color: #ac9d9e;">
        <.link
          navigate={~p"/"}
          class="transition-colors"
          style="color: #ac9d9e;"
          onmouseover="this.style.color='#444c72'"
          onmouseout="this.style.color='#ac9d9e'"
        >
          ← back to the notepad
        </.link>
      </div>
    </div>
  </div>
</div>
