<div id="stonetop-admin" class="admin-container stonetop-admin">
  <header class="admin-header">
    <h1>Stonetop Admin</h1>
    <nav class="family-admin-nav">
      <.link
        navigate={~p"/admin/stonetop/families"}
        id="families-admin-link"
        class="family-nav-link"
      >
        families →
      </.link>
      <.link
        navigate={~p"/admin/stonetop/sessions"}
        id="sessions-admin-link"
        class="family-nav-link"
      >
        sessions →
      </.link>
      <.link navigate={~p"/stonetop"} class="family-nav-link" target="_blank">
        public page ↗
      </.link>
    </nav>
  </header>

  <div class="admin-controls">
    <div class="admin-tabs" role="tablist">
      <button
        id="characters-tab"
        type="button"
        role="tab"
        aria-selected={to_string(@active_tab == "characters")}
        class={["admin-tab", @active_tab == "characters" && "active"]}
        phx-click="switch_tab"
        phx-value-tab="characters"
      >
        Characters <span class="admin-tab-count">{length(@characters)}</span>
      </button>
      <button
        id="relationships-tab"
        type="button"
        role="tab"
        aria-selected={to_string(@active_tab == "relationships")}
        class={["admin-tab", @active_tab == "relationships" && "active"]}
        phx-click="switch_tab"
        phx-value-tab="relationships"
      >
        Relationships <span class="admin-tab-count">{length(@relationships)}</span>
      </button>
    </div>

    <.button
      :if={@active_tab == "characters"}
      id="new-character"
      phx-click="new_character"
      variant="primary"
    >
      <.icon name="hero-plus" class="mr-2 size-4" /> New character
    </.button>
    <.button
      :if={@active_tab == "relationships"}
      id="new-relationship"
      phx-click="new_relationship"
      variant="primary"
      disabled={length(@characters) < 2}
    >
      <.icon name="hero-plus" class="mr-2 size-4" /> New relationship
    </.button>
  </div>

  <section :if={@active_tab == "characters"} id="characters-panel" class="admin-list">
    <div :if={@characters == []} id="characters-empty" class="admin-empty">
      No characters yet
    </div>
    <div :for={character <- @characters} id={"character-#{character.id}"} class="admin-item">
      <div class="st-row">
        <img :if={avatar_src(character)} src={avatar_src(character)} alt="" class="admin-thumb" />
        <div :if={!avatar_src(character)} class="admin-thumb placeholder">
          {String.first(character.name)}
        </div>
        <div class="admin-item-content">
          <div class="admin-item-header">
            <span class="comment-author">{character.name}</span>
            <span :for={tag <- character.tags} class="tag">{tag}</span>
          </div>
          <p :if={character.description} class="st-desc">{character.description}</p>
        </div>
      </div>
      <div class="admin-buttons">
        <button
          id={"edit-character-#{character.id}"}
          type="button"
          phx-click="edit_character"
          phx-value-id={character.id}
          class="admin-btn admin-btn-edit"
        >
          Edit
        </button>
        <button
          id={"delete-character-#{character.id}"}
          type="button"
          phx-click="delete_character"
          phx-value-id={character.id}
          data-confirm={"Delete #{character.name}? Their relationships go too."}
          class="admin-btn admin-btn-danger"
        >
          Delete
        </button>
      </div>
    </div>
  </section>

  <section :if={@active_tab == "relationships"} id="relationships-panel" class="admin-list">
    <div :if={@relationships == []} id="relationships-empty" class="admin-empty">
      {if length(@characters) < 2,
        do: "Add at least two characters first",
        else: "No relationships yet"}
    </div>
    <div :for={rel <- @relationships} id={"relationship-#{rel.id}"} class="admin-item">
      <div class="admin-item-content">
        <div class="admin-item-header">
          <span class="comment-author">{rel.source.name}</span>
          <span class="st-arrow">→</span>
          <span class="comment-author">{rel.target.name}</span>
          <span :for={tag <- rel.tags} class="tag">{tag}</span>
        </div>
        <p :if={rel.description} class="st-desc">{rel.description}</p>
      </div>
      <div class="admin-buttons">
        <button
          id={"edit-relationship-#{rel.id}"}
          type="button"
          phx-click="edit_relationship"
          phx-value-id={rel.id}
          class="admin-btn admin-btn-edit"
        >
          Edit
        </button>
        <button
          id={"delete-relationship-#{rel.id}"}
          type="button"
          phx-click="delete_relationship"
          phx-value-id={rel.id}
          data-confirm="Delete this relationship?"
          class="admin-btn admin-btn-danger"
        >
          Delete
        </button>
      </div>
    </div>
  </section>
</div>

<.modal
  :if={@modal == :character}
  id="character-modal"
  show={true}
  on_close="close_modal"
  title={if @editing.id, do: "Edit #{@editing.name}", else: "New Character"}
>
  <.form
    for={@form}
    id="character-form"
    phx-change="validate_character"
    phx-submit="save_character"
  >
    <.input field={@form[:name]} label="Name" required />
    <.input field={@form[:description]} label="Description" type="textarea" rows={4} />
    <.input
      field={@form[:tags_input]}
      label="Tags (comma-separated)"
      placeholder="pc, npc, villain"
    />

    <div class="input-field avatar-upload">
      <span class="input-label">Portrait</span>
      <label
        for={@uploads.avatar.ref}
        class="upload-dropzone"
        phx-drop-target={@uploads.avatar.ref}
      >
        <.live_file_input upload={@uploads.avatar} />
        <.icon name="hero-photo" class="upload-icon size-8" />
        <p class="upload-text">Drop an image or click to choose</p>
        <p class="upload-hint">jpg, png, or webp · up to 8MB</p>
      </label>

      <div :for={entry <- @uploads.avatar.entries} class="upload-preview">
        <.live_img_preview entry={entry} class="preview-img" />
        <div>
          <p class="upload-text">{entry.client_name}</p>
          <p :for={err <- upload_errors(@uploads.avatar, entry)} class="upload-error">
            {upload_error(err)}
          </p>
          <button
            type="button"
            phx-click="cancel_avatar"
            phx-value-ref={entry.ref}
            class="admin-btn admin-btn-danger remove-upload"
          >
            Remove
          </button>
        </div>
      </div>

      <div :if={@uploads.avatar.entries == [] && avatar_src(@editing)} class="upload-preview">
        <img src={avatar_src(@editing)} alt="" class="preview-img" />
        <p class="upload-hint">Current portrait. Choose a new image to replace it.</p>
      </div>

      <p :for={err <- upload_errors(@uploads.avatar)} class="upload-error">{upload_error(err)}</p>
    </div>

    <div class="form-actions">
      <.button type="submit" variant="primary" phx-disable-with="Saving…">Save</.button>
      <.button type="button" phx-click="close_modal">Cancel</.button>
    </div>
  </.form>
</.modal>

<.modal
  :if={@modal == :relationship}
  id="relationship-modal"
  show={true}
  on_close="close_modal"
  title={if @editing.id, do: "Edit Relationship", else: "New Relationship"}
>
  <.form
    for={@form}
    id="relationship-form"
    phx-change="validate_relationship"
    phx-submit="save_relationship"
  >
    <.input
      field={@form[:source_id]}
      label="From"
      type="select"
      options={Enum.map(@characters, &{&1.name, &1.id})}
      prompt="Choose…"
      required
    />
    <.input
      field={@form[:target_id]}
      label="To"
      type="select"
      options={Enum.map(@characters, &{&1.name, &1.id})}
      prompt="Choose…"
      required
    />
    <.input
      field={@form[:description]}
      label="Description"
      type="textarea"
      rows={4}
      placeholder="e.g. Childhood rivals, compete for the elder's favor"
    />
    <.input
      field={@form[:tags]}
      value={tags_value(@form)}
      label="Tags (comma-separated)"
      placeholder="rivalry, childhood, politics"
    />

    <div class="form-actions">
      <.button type="submit" variant="primary" phx-disable-with="Saving…">Save</.button>
      <.button type="button" phx-click="close_modal">Cancel</.button>
    </div>
  </.form>
</.modal>

<Layouts.flash_group flash={@flash} />
