<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="comment-moderation" class="space-y-6">
    <div class="flex items-end justify-between gap-6 border-b border-slate-200 pb-3">
      <h1 class="font-serif text-2xl text-slate-900">Comment Moderation</h1>
      <div class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
        Total {@total_count}
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <.form for={@filter_form} id="filter-form" phx-change="filter_by_post">
        <div class="flex items-center gap-3">
          <label
            for="post-filter"
            class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
          >
            Filter
          </label>
          <.input
            type="select"
            field={@filter_form[:post_id]}
            id="post-filter"
            options={[{"All Posts", ""} | @post_options]}
          />
        </div>
      </.form>

      <div
        id="filter-count"
        class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 font-mono text-xs text-slate-500"
      >
        {@filtered_count}
      </div>
    </div>

    <div
      id="comments"
      phx-update="stream"
      class="divide-y divide-slate-200 border border-slate-200"
    >
      <div
        id="comments-empty"
        class="hidden only:block px-4 py-6 text-center font-mono text-xs text-slate-500"
      >
        No comments yet
      </div>
      <div
        :for={{id, comment} <- @streams.comments}
        id={id}
        class="flex flex-wrap items-start justify-between gap-6 px-4 py-3 text-slate-900"
      >
        <div class="min-w-0 flex-1 space-y-2">
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-sans text-sm font-semibold text-slate-900">
              {comment.author_name}
            </span>
            <span class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">
              {Map.get(@post_titles, comment.post_id, comment.post_id)}
            </span>
          </div>
          <p class="font-sans text-sm leading-relaxed text-slate-700">
            {comment.body}
          </p>
        </div>

        <div class="flex w-full items-center justify-between gap-4 sm:w-auto sm:flex-col sm:items-end sm:justify-start">
          <span class="font-mono text-xs text-slate-500">
            {format_timestamp(comment.inserted_at)}
          </span>
          <div class="flex items-center gap-2">
            <button
              :if={@confirming_comment_id != comment.id}
              id={"comment-delete-#{comment.id}"}
              type="button"
              phx-click="confirm_delete"
              phx-value-id={comment.id}
              class="text-xs font-mono uppercase tracking-[0.16em] text-slate-500 transition hover:text-slate-900"
            >
              Delete
            </button>
            <button
              :if={@confirming_comment_id == comment.id}
              id={"comment-confirm-#{comment.id}"}
              type="button"
              phx-click="delete_comment"
              phx-value-id={comment.id}
              class="text-xs font-mono uppercase tracking-[0.16em] text-red-600 transition hover:text-red-700"
            >
              Confirm delete
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
