<div id="comment-moderation" class="admin-container">
  <header class="admin-header">
    <h1>Comment Moderation</h1>
    <div class="admin-count">
      Total {@total_count}
    </div>
  </header>

  <div class="admin-controls">
    <.form for={@filter_form} id="filter-form" phx-change="filter_by_post">
      <div class="filter-group">
        <label for="post-filter" class="filter-label">
          Filter
        </label>
        <.input
          type="select"
          field={@filter_form[:post_id]}
          id="post-filter"
          options={[{"All Posts", ""} | @post_options]}
          class="admin-select"
        />
      </div>
    </.form>

    <div id="filter-count" class="admin-badge">
      {@filtered_count}
    </div>
  </div>

  <div id="comments" phx-update="stream" class="admin-list">
    <div
      id="comments-empty"
      class="hidden only:block admin-empty"
    >
      No comments yet
    </div>
    <div
      :for={{id, comment} <- @streams.comments}
      id={id}
      class="admin-item"
    >
      <div class="admin-item-content">
        <div class="admin-item-header">
          <span class="comment-author">
            {comment.author_name}
          </span>
          <span class="comment-post">
            {Map.get(@post_titles, comment.post_id, comment.post_id)}
          </span>
        </div>
        <p class="comment-body">
          {comment.body}
        </p>
      </div>

      <div class="admin-item-actions">
        <span class="comment-timestamp">
          {format_timestamp(comment.inserted_at)}
        </span>
        <div class="admin-buttons">
          <button
            :if={@confirming_comment_id != comment.id}
            id={"comment-delete-#{comment.id}"}
            type="button"
            phx-click="confirm_delete"
            phx-value-id={comment.id}
            class="admin-btn admin-btn-danger"
          >
            Delete
          </button>
          <button
            :if={@confirming_comment_id == comment.id}
            id={"comment-confirm-#{comment.id}"}
            type="button"
            phx-click="delete_comment"
            phx-value-id={comment.id}
            class="admin-btn admin-btn-danger-confirm"
          >
            Confirm delete
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<Layouts.flash_group flash={@flash} />
