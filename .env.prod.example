# Production Environment Variables
# Copy this file to .env.prod on your server and fill in the values
# DO NOT commit .env.prod to version control!

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_MIX_PHX_GEN_SECRET

# Start the Phoenix server
PHX_SERVER=true

# Port for Phoenix to listen on (nginx will proxy to this)
PORT=4000

# PostgreSQL Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=indie_prod
DATABASE_USER=indie
DATABASE_PASSWORD=CHANGE_ME_SET_SECURE_PASSWORD

# Your domain name
PHX_HOST=glorifiednotepad.net

# Optional: Pool size for database connections
POOL_SIZE=10

# Where stonetop avatar uploads are written (served by nginx at /uploads/)
UPLOADS_DIR=/var/lib/indie/uploads
# Where posts live (inside the current release)
CONTENT_DIR=/opt/indie/current/content
