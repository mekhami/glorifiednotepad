[Unit]
Description=glorified notepad Phoenix application
After=network.target postgresql.service

[Service]
Type=simple
User=indie
Group=indie
WorkingDirectory=/opt/indie/current
EnvironmentFile=/opt/indie/shared/.env.prod
Environment=RELEASE_TMP=/tmp
ExecStart=/opt/indie/current/bin/server
Restart=on-failure
RestartSec=5
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indie

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/indie /opt/indie

[Install]
WantedBy=multi-user.target
